{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "water-polo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
